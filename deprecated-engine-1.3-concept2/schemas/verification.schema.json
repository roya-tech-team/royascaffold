{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "royascaff/verification/v1",
  "type": "object",
  "required": ["schema", "change", "source_revision", "deterministic", "semantic", "overall"],
  "properties": {
    "schema": { "const": "royascaff/verification/v1" },
    "change": { "type": "string", "pattern": "^CHG-" },
    "source_revision": { "type": "string", "minLength": 1 },
    "deterministic": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "working_directory", "source_revision", "executed_at", "outcome", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "working_directory": { "type": "string", "minLength": 1 },
          "source_revision": { "type": "string", "minLength": 1 },
          "executed_at": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["pass", "fail", "blocked"] },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "semantic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "outcome", "disposition"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["pass", "fail", "waived", "blocked"] },
          "disposition": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "overall": { "enum": ["pass", "fail", "blocked"] }
  },
  "additionalProperties": true
}
