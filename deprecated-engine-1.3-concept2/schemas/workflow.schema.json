{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "royascaff/workflow-definition/v1",
  "type": "object",
  "required": ["schema", "name", "version", "purpose", "steps"],
  "properties": {
    "schema": { "const": "royascaff/workflow-definition/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 10 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill"],
        "properties": {
          "id": { "type": "string" },
          "skill": { "type": "string" },
          "requires": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
