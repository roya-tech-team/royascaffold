{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royascaff.dev/schemas/v1/execution-task.schema.json",
  "title": "RoyaScaff Executable Task",
  "type": "object",
  "required": ["id", "goal", "preconditions", "inputs", "allowed_paths", "forbidden_inventions", "steps", "outputs", "checks", "done_when", "recovery", "handoff"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-(?:[A-Z0-9]+-){1,}[A-Z0-9]+$" },
    "goal": { "type": "string", "minLength": 1 },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_inventions": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "checks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "done_when": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recovery": { "type": "array", "items": { "type": "string" } },
    "handoff": { "type": "string" }
  },
  "additionalProperties": true
}

