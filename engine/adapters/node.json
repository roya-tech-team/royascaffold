{
  "adapter": "node",
  "legacyAppTypes": [],
  "personCheck": {
    "kind": "transcript",
    "bar": "Usage bar",
    "minLines": 3,
    "prompt": "read the recorded run of the commands and their output, and score it against the usage bar",
    "record": "Transcript"
  },
  "personLook": {
    "kinds": [
      "feature"
    ],
    "minRisk": "high"
  },
  "lockfiles": [
    "package-lock.json",
    "npm-shrinkwrap.json",
    "yarn.lock",
    "pnpm-lock.yaml"
  ],
  "scan": {
    "extensions": [
      ".js",
      ".cjs",
      ".mjs",
      ".jsx",
      ".ts",
      ".tsx",
      ".vue",
      ".svelte"
    ],
    "patterns": {
      "imports": [
        "\\bfrom\\s*['\"]([^'\"]+)['\"]",
        "\\bimport\\s*['\"]([^'\"]+)['\"]",
        "\\brequire\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)"
      ],
      "exports": [
        "^\\s*export\\s+(?:default\\s+)?(?:async\\s+)?(?:function\\*?|class|const|let|var)\\s+(\\w+)",
        "^\\s*exports\\.(\\w+)\\s*=",
        "^\\s*module\\.exports\\.(\\w+)\\s*=",
        {
          "pattern": "^\\s*module\\.exports\\s*=\\s*\\{([^}]*)\\}",
          "split": ","
        }
      ],
      "routes": [
        "\\b(?:app|router|server)\\.(?:get|post|put|patch|delete|all|use)\\(\\s*['\"`](/[^'\"`]*)['\"`]"
      ]
    },
    "schemaFiles": [
      "(^|/)(migrations?|schema)/",
      "\\.sql$",
      "(^|/)schema\\.[a-z]+$"
    ],
    "configFiles": [
      "(^|/)tsconfig[^/]*\\.json$",
      "(^|/)[^/]*\\.config\\.[cm]?[jt]s$",
      "(^|/)\\.eslintrc[^/]*$"
    ]
  },
  "tests": {
    "files": [
      "(\\.test\\.|\\.spec\\.)[cm]?[jt]sx?$",
      "(^|/)__tests__/.+\\.[cm]?[jt]sx?$"
    ],
    "readsSource": [
      {
        "pattern": "(?:from\\s*|import\\s*\\(\\s*)['\"`][^'\"`]+\\?raw['\"`]",
        "why": "imports source as text (?raw)"
      },
      {
        "call": "\\b(readFileSync|readFile|readTextFile)\\s*\\(([^;]{0,200}?)\\)",
        "args": [
          "['\"`][^'\"`]*(?:^|[\\/.])src\\/",
          "['\"`]src['\"`]",
          "['\"`][^'\"`]*\\.(?:[cm]?[jt]sx?|vue|svelte)['\"`]"
        ],
        "why": "reads application source as text ($1)"
      }
    ]
  },
  "deps": {
    "manifest": "package.json",
    "fields": [
      "dependencies"
    ],
    "scriptsField": "scripts",
    "ignore": [
      "^@types/"
    ],
    "sourceFiles": "\\.(?:[cm]?[jt]sx?|vue|svelte|astro|html|css|scss|sass|less)$|config\\.[cm]?[jt]s$",
    "skipFolders": [
      "node_modules",
      ".git",
      "dist",
      "build",
      "coverage",
      ".next",
      ".cache",
      "out",
      "vendor",
      "scripts"
    ],
    "imports": [
      "\\bfrom\\s*['\"]([^'\"]+)['\"]",
      "\\bimport\\s*['\"]([^'\"]+)['\"]",
      "\\bimport\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)",
      "\\brequire\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)",
      "@(?:import|use|forward)\\s+(?:url\\()?['\"]([^'\"]+)['\"]"
    ],
    "implicit": [
      {
        "pattern": "@tailwind\\s+(base|components|utilities)",
        "package": "tailwindcss"
      }
    ],
    "specifier": {
      "skip": "^[./]|^node:|^[a-z]+://|^~/|^#",
      "separator": "/",
      "scopePrefix": "@"
    }
  }
}
