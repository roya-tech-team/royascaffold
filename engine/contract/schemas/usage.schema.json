{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/usage.schema.json",
  "title": "royascaff usage: data",
  "description": "The `data` of the contract envelope for `usage`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "enabled",
    "file",
    "usage",
    "stages"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "file": {
      "type": "string"
    },
    "usage": {
      "type": "object"
    },
    "stages": {
      "type": "object"
    }
  }
}
