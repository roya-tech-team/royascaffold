{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/status.schema.json",
  "title": "royascaff status: data",
  "description": "The `data` of the contract envelope for `status`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "next",
    "features",
    "changes",
    "outside",
    "issues"
  ],
  "properties": {
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "title",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "outside": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "health": {
      "type": "object"
    }
  }
}
