{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/migrate.schema.json",
  "title": "royascaff migrate: data",
  "description": "The `data` of the contract envelope for `migrate`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "validation": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        }
      }
    },
    "errors": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    },
    "lost": {
      "type": "array"
    },
    "archived": {
      "type": "array"
    }
  }
}
