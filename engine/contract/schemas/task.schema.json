{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/task.schema.json",
  "title": "royascaff task: data",
  "description": "The `data` of the contract envelope for `task`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "id",
    "change",
    "state",
    "tasksDone",
    "tasksTotal"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "change": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "tasksDone": {
      "type": "integer"
    },
    "tasksTotal": {
      "type": "integer"
    }
  }
}
