{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.2/runner/event.tool_use.json",
  "title": "Runner event: tool_use",
  "description": "The agent used a tool.",
  "type": "object",
  "required": [
    "job_id",
    "seq",
    "at",
    "type",
    "tool"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "1, 2, 3 … in the order the runner produced the events."
    },
    "at": {
      "type": "string",
      "description": "ISO time."
    },
    "type": {
      "type": "string",
      "const": "tool_use"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "summary": {
      "type": "string"
    }
  }
}
