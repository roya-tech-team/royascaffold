{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/install.schema.json",
  "title": "royascaff install: data",
  "description": "The `data` of the contract envelope for `install`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "tools",
    "cli",
    "skill_files",
    "docs_created"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cli": {
      "type": "string"
    },
    "mcp": {
      "description": "Added in contract 1.2: the MCP server registration per tool (.mcp.json, .cursor/mcp.json).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "file", "action"],
        "properties": {
          "tool": { "type": "string" },
          "file": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "added", "replaced", "kept", "unchanged"] }
        }
      }
    },
    "skill_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs_created": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
