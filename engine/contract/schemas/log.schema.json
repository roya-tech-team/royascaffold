{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/log.schema.json",
  "title": "royascaff log: data",
  "description": "The `data` of the contract envelope for `log`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
