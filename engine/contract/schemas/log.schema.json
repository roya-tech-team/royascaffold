        "required": [
          "change",
          "when",
          "event",
          "target",
          "by"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  }
}
