{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/show.schema.json",
  "title": "royascaff show: data",
  "description": "The `data` of the contract envelope for `show`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "source",
    "fields",
    "relations",
    "incoming",
    "mentions",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "fields": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "to"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "incoming": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text": {
      "type": "string"
    },
    "status": {
      "type": "object"
    }
  }
}
