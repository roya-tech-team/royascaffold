{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://royascaff.dev/contract/1.0/record.schema.json",
  "title": "royascaff record: data",
  "description": "The `data` of the contract envelope for `record`. Extra fields are allowed: adding a field is a minor change.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "commits",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
