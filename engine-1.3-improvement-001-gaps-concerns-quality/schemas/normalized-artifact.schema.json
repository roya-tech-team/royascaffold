{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royascaff.dev/schemas/v1/normalized-artifact.schema.json",
  "title": "Normalized RoyaScaff Artifact",
  "type": "object",
  "required": ["id", "kind", "title", "knowledge_status", "implementation_status", "owner", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}$" },
    "kind": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "knowledge_status": { "enum": ["draft", "in-review", "approved", "deprecated", "superseded"] },
    "implementation_status": { "enum": ["not-planned", "planned", "partial", "implemented", "verified", "not-applicable"] },
    "owner": { "type": "string", "minLength": 1 },
    "relations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verified_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
