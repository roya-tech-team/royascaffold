{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royascaff.dev/schemas/v1.3.1/adapter.schema.json",
  "title": "RoyaScaff Adapter Manifest",
  "type": "object",
  "required": ["adapter_id", "adapter_version", "axes", "requires", "incompatible_with", "precedence"],
  "properties": {
    "adapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "axes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" }, "minItems": 1, "uniqueItems": true },
    "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "incompatible_with": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "precedence": { "type": "integer", "minimum": 0 },
    "runner_hooks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": true
}
