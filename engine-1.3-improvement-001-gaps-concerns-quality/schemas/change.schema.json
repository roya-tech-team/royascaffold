{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royascaff.dev/schemas/v1.3.1/change.schema.json",
  "title": "RoyaScaff Change",
  "type": "object",
  "required": ["change_id", "status", "intent", "risk", "baseline_revision", "owners"],
  "properties": {
    "change_id": { "type": "string", "pattern": "^CHG-(?:[A-Z0-9]+-){1,}[A-Z0-9]+$" },
    "status": { "enum": ["draft", "analyzed", "approved", "ready", "in-progress", "failed", "verified", "reconciled", "closed", "blocked", "cancelled"] },
    "intent": { "type": "string" },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "uncertainty": { "enum": ["low", "medium", "high"] },
    "judgment": { "enum": ["low", "medium", "high"] },
    "artifact_mode": { "enum": ["compact", "standard", "rigorous"] },
    "adoption_mode": { "enum": ["legacy-compatible", "transition", "strict"] },
    "selected_adapters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rejected_adapters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_gates": { "type": "array", "items": { "enum": ["solution-quality-review", "implementation-readiness-review"] }, "uniqueItems": true },
    "baseline_revision": { "type": "string" },
    "owners": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "adoption_mode": { "const": "strict" } }, "required": ["adoption_mode"] },
      "then": { "required": ["uncertainty", "judgment", "artifact_mode", "selected_adapters", "required_gates"] }
    }
  ],
  "additionalProperties": true
}
