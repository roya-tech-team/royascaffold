{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "royascaff/skill/v1",
  "type": "object",
  "required": ["schema", "name", "version", "purpose", "required_inputs", "context_policy", "allowed_mutations", "outputs", "validation", "failure_conditions"],
  "properties": {
    "schema": { "const": "royascaff/skill/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 10 },
    "required_inputs": { "type": "array", "items": { "type": "string" } },
    "context_policy": {
      "type": "object",
      "required": ["seeds", "required_relations", "optional_relations", "exclude"],
      "properties": {
        "seeds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required_relations": { "type": "array", "items": { "type": "string" } },
        "optional_relations": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowed_mutations": { "type": "array", "items": { "type": "string" } },
    "forbidden_mutations": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "array", "items": { "type": "string" } },
    "failure_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
