{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "royascaff/change/v1",
  "type": "object",
  "required": ["schema", "id", "title", "type", "state", "owner", "base_revision", "risk", "affects"],
  "properties": {
    "schema": { "const": "royascaff/change/v1" },
    "id": { "type": "string", "pattern": "^CHG-[0-9]{8}-[0-9]{6}(?:-[a-f0-9]{4})?$" },
    "title": { "type": "string", "minLength": 3 },
    "type": { "enum": ["initial", "feature", "change", "bug", "polish", "refactor", "architecture", "migration", "security", "documentation"] },
    "state": { "enum": ["draft", "analyzed", "approved", "planned", "in-progress", "implemented", "verified", "reconciled", "blocked", "abandoned"] },
    "owner": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "affects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "new_artifacts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "exclusive_artifacts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "exclusive_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "outcome", "at", "subject_revision"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["approved", "rejected"] },
          "at": { "type": "string", "minLength": 1 },
          "subject_revision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "at"],
        "properties": {
          "state": { "enum": ["draft", "analyzed", "approved", "planned", "in-progress", "implemented", "verified", "reconciled", "blocked", "abandoned"] },
          "at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
