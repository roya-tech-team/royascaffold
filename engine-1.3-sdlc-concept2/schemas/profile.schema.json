{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "royascaff/project-profile/v1",
  "type": "object",
  "required": ["schema", "project", "version", "source_roots", "owners"],
  "properties": {
    "schema": { "const": "royascaff/project-profile/v1" },
    "project": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source_roots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "code_map_exclude": { "type": "array", "items": { "type": "string" } },
    "code_extensions": { "type": "array", "items": { "type": "string" } },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "adapters": { "type": "array", "items": { "type": "string" } },
    "commands": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": true
}
